{% extends 'layout/main.html.twig' %}

{% block title %}{{ event.titre }} - EventCampus{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('app_accueil') }}">Accueil</a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_evenements') }}">Événements</a></li>
        <li class="breadcrumb-item active">{{ event.titre }}</li>
    </ol>
</nav>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-img-top bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 300px;">
                <span class="display-1">📅</span>
            </div>
            <div class="card-body">
                <h1 class="card-title">{{ event.titre }}</h1>

                <div class="mb-3">
                    <span class="badge
                        {% if event.statut == 'ouvert' %}bg-success
                        {% elseif event.statut == 'complet' %}bg-danger
                        {% else %}bg-secondary{% endif %} fs-6">
                        {{ event.statut|capitalize }}
                    </span>
                    <span class="badge bg-primary fs-6">{{ event.categorie|capitalize }}</span>
                </div>

                <p class="lead">{{ event.description }}</p>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Informations</h5>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">
                    <strong>📍 Lieu :</strong><br>
                    {{ event.lieu }}
                </li>
                <li class="list-group-item">
                    <strong>📆 Début :</strong><br>
                    {{ event.date_debut|date('d/m/Y à H:i') }}
                </li>
                <li class="list-group-item">
                    <strong>🏁 Fin :</strong><br>
                    {{ event.date_fin|date('d/m/Y à H:i') }}
                </li>
                <li class="list-group-item">
                    <strong>👤 Organisateur :</strong><br>
                    {{ event.organisateur }}
                </li>
                <li class="list-group-item">
                    <strong>💰 Prix :</strong><br>
                    {% if event.prix > 0 %}
                        {{ event.prix }}€
                    {% else %}
                        <span class="text-success">Gratuit</span>
                    {% endif %}
                </li>
            </ul>
        </div>

        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Places</h5>
            </div>
            <div class="card-body">
                {% set placesOccupees = event.places_totales - event.places_disponibles %}
                {% set pourcentage = event.places_totales > 0 ? (placesOccupees / event.places_totales * 100) : 0 %}

                <p class="mb-2">
                    <strong>{{ event.places_disponibles }}</strong> places disponibles sur <strong>{{ event.places_totales }}</strong>
                </p>

                <div class="progress" style="height: 25px;">
                    <div class="progress-bar
                        {% if pourcentage >= 90 %}bg-danger
                        {% elseif pourcentage >= 70 %}bg-warning
                        {% else %}bg-success{% endif %}"
                        role="progressbar"
                        style="width: {{ pourcentage }}%">
                        {{ pourcentage|round }}%
                    </div>
                </div>

                {% if event.statut == 'complet' %}
                    <div class="alert alert-danger mt-3 mb-0">
                        Cet événement est complet.
                    </div>
                {% elseif event.statut == 'annulé' %}
                    <div class="alert alert-secondary mt-3 mb-0">
                        Cet événement a été annulé.
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a href="{{ path('app_evenements') }}" class="btn btn-outline-secondary">
        ← Retour à la liste
    </a>
</div>
{% endblock %}
